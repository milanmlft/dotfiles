// OMO configuration
// Model mappings target the self-hosted LiteLLM gateway declared in
// ~/.config/opencode/opencode.jsonc. The installer's auto-generated defaults
// pointed every agent at `opencode/gpt-5-nano` (OpenCode Zen), which is not
// available on this machine, so they are overridden here.
//
// NOTE: telemetry must be the boolean form inside the [opencode] block.
// A base-scope `"telemetry": { "enabled": false }` object appears in the
// published JSON schema but is REJECTED by the runtime config validator
// (doctor reports "Invalid configuration"). Do not add it back.
{
  "[opencode]": {
    "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
    "telemetry": false,
    "team_mode": {
      "enabled": true,
      "max_parallel_members": 4,
      "max_members": 8,
      "max_messages_per_run": 10000,
      "max_wall_clock_minutes": 120,
      "max_member_turns": 500,
      "message_payload_max_bytes": 32768,
      "recipient_unread_max_bytes": 262144,
      "mailbox_poll_interval_ms": 3000
    },
    "agents": {
      // Main orchestrator: Claude Opus or Kimi K3 work best
      "sisyphus": {
        "model": "litellm/unifiedai-poc/deepseek-v4.1-flash"
      },
      // Strategic planner: interviews and explores codebase to make a plan
      "prometheus": {
        "model": "litellm/anthropic/claude-sonnet-5"
      },
      // Master executor: read plans and delegates tasks
      "atlas": {
        "model": "litellm/unifiedai-poc/deepseek-v4.1-flash"
      },
      // Specialist developer, GPT-optimised
      "hephaestus": {
        "model": "litellm/unifiedai-poc/deepseek-v4.1-flash"
      },
      // Architecture consultation
      "oracle": {
        "model": "litellm/qwen/kimi-k3",
        "variant": "high"
      },
      // Plan consultant: catches ambiguities in plans
      "metis": {
        "model": "litellm/unifiedai-poc/deepseek-v4.1-flash"
      },
      // Plan reviewer
      "momus": {
        "model": "litellm/unifiedai-poc/deepseek-v4.1-flash"
      },
      // Focused task executor
      "sisyphus-junior": {
        "model": "litellm/condenser-poc/qwen-3.8-27b-int4-redhatai"
      },
      // Research agents: cheaper models are fine
      "explore": {
        "model": "litellm/condenser-poc/qwen-3.8-27b-int4-redhatai"
      },
      "librarian": {
        "model": "litellm/condenser-poc/qwen-3.8-27b-int4-redhatai"
      },
      // Media analysis
      "multimodal-looker": {
        "model": "litellm/unifiedai-poc/deepseek-v4.1-flash"
      }
    },
    "categories": {
      "ultrabrain": {
        "model": "litellm/anthropic/claude-opus-5"
      },
      "artistry": {
        "model": "litellm/qwen/kimi-k3"
      },
      "unspecified-high": {
        "model": "litellm/anthropic/claude-sonnet-5"
      },
      "deep": {
        "model": "anthropic/claude-sonnet-5"
      },
      "visual-engineering": {
        "model": "anthropic/claude-sonnet-5"
      },
      "writing": {
        "model": "litellm/condenser-poc/qwen-3.8-27b-int4-redhatai"
      },
      "unspecified-low": {
        "model": "litellm/qwen/qwen3.7-flash"
      },
      "quick": {
        "model": "litellm/anthropic/claude-haiku-4-5"
      }
    },
    "tmux": {
      "enabled": false
    }
  },
  "_migrations": [
    "2026-08-reasoning-unification"
  ]
}
