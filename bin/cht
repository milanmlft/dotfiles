#!/usr/bin/env bash
# cht — fuzzy cheat.sh lookup. Multiplexer-agnostic: run it anywhere,
# or via `Alt a` + `i` in zellij, where it opens as a floating popup.
set -euo pipefail

topic=$(curl -fsS https://cht.sh/:list | fzf --reverse --prompt='cht.sh> ') || exit 0
read -r -p "query (optional): " query || true
query=${query// /+}

curl -fsS "https://cht.sh/${topic}${query:+/$query}?style=rrt" | less -R
