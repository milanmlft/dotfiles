{
  "plugin": [
    "oh-my-openagent@latest",
    "/opt/homebrew/lib/node_modules/@rynfar/meridian/dist/meridian"
  ],
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://litellm.arc-llm.condenser.arc.ucl.ac.uk/"
      },
      "models": {
        "anthropic/claude-opus-5": {
          "name": "Claude Opus 5"
        },
        "anthropic/claude-sonnet-5": {
          "name": "Claude Sonnet 5"
        },
        "anthropic/claude-haiku-4-5": {
          "name": "Claude Haiku 4.5"
        },
        // "openai/gpt-5.6-terra": {
        //   "name": "GPT-5.6 Terra"
        // },
        // "openai/gpt-5.6-luna": {
        //   "name": "GPT-5.6 Luna"
        // },
        // "moonshot/kimi-k3": {
        //   "name": "Moonshot Kimi K3"
        // },
        "qwen/kimi-k3": {
          "name": "Qwen Kimi K3"
        },
        "zai/glm-5.3": {
          "name": "GLM 5.3"
        },
        "qwen/qwen3.7-flash": {
          "name": "Qwen 3.7 Flash"
        },
        "condenser-poc/qwen-3.8-27b-int4-redhatai": {
          "name": "Condenser Qwen 3.8 27b"
        },
        "unifiedai-poc/deepseek-v4.1-flash": {
          "name": "UnifiedAI DeepSeek v4.1 flash"
        }
      }
    }
  },
}
