// `zj -l dev` : editor tab + shell tab, both in the project root
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
        children
    }
    tab name="edit" focus=true {
        pane command="nvim" name="nvim"
    }
    tab name="shell" {
        pane
    }
}
