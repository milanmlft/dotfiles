// Zellij config — tmux-flavoured, collision-free
// ------------------------------------------------------------------
// Design:
//  * Zellij starts in "locked" mode, so every key goes straight to
//    nvim / zsh / fzf / lazygit. Nothing to fight with.
//  * `Alt a` (the old tmux prefix) enters "tmux" mode; one key later
//    you're back in locked mode. Bindings mirror the old tmux.conf.
//  * No bare `Alt h/j/k/l/o/s/…` binds: AeroSpace owns those globally.
//  * Requires Ghostty's `macos-option-as-alt = true` (already set).
//
// Cheat sheet (after Alt a):
//   h j k l   focus pane          "  %     split down / right
//   c         new tab             n p ^   next / prev / last tab
//   1-9       go to tab           ,       rename tab
//   x         close pane          z       zoom pane
//   ;         last pane           Space   next swap layout
//   w         toggle floating     e       float <-> embed pane
//   [         scroll mode         /       search scrollback
//   r         resize mode         m       move mode
//   o         sessionizer (zj)    s       session manager
//   L         layout manager      g       lazygit popup      
//   d         detach
// ------------------------------------------------------------------

keybinds clear-defaults=true {
    locked {
        bind "Alt a" { SwitchToMode "tmux"; }
    }

    tmux {
        bind "Alt a" { Write 27 97; SwitchToMode "locked"; }

        // panes
        bind "h" "Left"  { MoveFocus "left";  SwitchToMode "locked"; }
        bind "j" "Down"  { MoveFocus "down";  SwitchToMode "locked"; }
        bind "k" "Up"    { MoveFocus "up";    SwitchToMode "locked"; }
        bind "l" "Right" { MoveFocus "right"; SwitchToMode "locked"; }
        bind ";" { FocusLastPane; SwitchToMode "locked"; }
        bind "\"" { NewPane "down";  SwitchToMode "locked"; }
        bind "%"  { NewPane "right"; SwitchToMode "locked"; }
        bind "x" { CloseFocus; SwitchToMode "locked"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "locked"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "locked"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "locked"; }
        bind "P" { TogglePanePinned; SwitchToMode "locked"; }
        bind "Space" { NextSwapLayout; }

        // tabs (tmux "windows")
        bind "c" { NewTab; SwitchToMode "locked"; }
        bind "n" { GoToNextTab; SwitchToMode "locked"; }
        bind "p" { GoToPreviousTab; SwitchToMode "locked"; }
        bind "^" "Tab" { ToggleTab; SwitchToMode "locked"; }
        bind "," { SwitchToMode "renametab"; TabNameInput 0; }
        bind "b" { BreakPane; SwitchToMode "locked"; }
        bind "1" { GoToTab 1; SwitchToMode "locked"; }
        bind "2" { GoToTab 2; SwitchToMode "locked"; }
        bind "3" { GoToTab 3; SwitchToMode "locked"; }
        bind "4" { GoToTab 4; SwitchToMode "locked"; }
        bind "5" { GoToTab 5; SwitchToMode "locked"; }
        bind "6" { GoToTab 6; SwitchToMode "locked"; }
        bind "7" { GoToTab 7; SwitchToMode "locked"; }
        bind "8" { GoToTab 8; SwitchToMode "locked"; }
        bind "9" { GoToTab 9; SwitchToMode "locked"; }

        // modes
        bind "[" { SwitchToMode "scroll"; }
        bind "/" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "r" { SwitchToMode "resize"; }
        bind "m" { SwitchToMode "move"; }

        // sessions & popups
        bind "o" {
            Run "zj" {
                floating true
                close_on_exit true
                name "sessionizer"
            }
            SwitchToMode "locked"
        }
        bind "s" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "L" {
            LaunchOrFocusPlugin "zellij:layout-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "g" {
            Run "lazygit" {
                floating true
                close_on_exit true
                name "lazygit"
            }
            SwitchToMode "locked"
        }
        bind "d" { Detach; }

        // nested zellij sessions (e.g. zellij on a remote VM)
        bind "]" { FocusHostSession; SwitchToMode "locked"; }
        bind "F" { ToggleHostFullscreen; SwitchToMode "locked"; }

        bind "Esc" "Enter" "Ctrl c" { SwitchToMode "locked"; }
    }

    resize {
        bind "h" "Left"  { Resize "Increase left"; }
        bind "j" "Down"  { Resize "Increase down"; }
        bind "k" "Up"    { Resize "Increase up"; }
        bind "l" "Right" { Resize "Increase right"; }
        bind "H" { Resize "Decrease left"; }
        bind "J" { Resize "Decrease down"; }
        bind "K" { Resize "Decrease up"; }
        bind "L" { Resize "Decrease right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
        bind "Esc" "Enter" "Ctrl c" { SwitchToMode "locked"; }
    }

    move {
        bind "h" "Left"  { MovePane "left"; }
        bind "j" "Down"  { MovePane "down"; }
        bind "k" "Up"    { MovePane "up"; }
        bind "l" "Right" { MovePane "right"; }
        bind "n" "Tab" { MovePane; }
        bind "p" { MovePaneBackwards; }
        bind "Esc" "Enter" "Ctrl c" { SwitchToMode "locked"; }
    }

    shared_among "scroll" "search" {
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up"   { ScrollUp; }
        bind "d" "Ctrl d" { HalfPageScrollDown; }
        bind "u" "Ctrl u" { HalfPageScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp"   { PageScrollUp; }
        bind "g" { ScrollToTop; }
        bind "G" { ScrollToBottom; }
        bind "[" { ScrollToPreviousPrompt; }
        bind "]" { ScrollToNextPrompt; }
        bind "m" { SelectCommandAtScrollPosition; }
        bind "e" { EditScrollback; SwitchToMode "locked"; }
        bind "/" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "q" "Esc" "Ctrl c" { ScrollToBottom; SwitchToMode "locked"; }
    }
    scroll {
        bind "c" { CopyLastCommandOutput; SwitchToMode "locked"; }
    }
    search {
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }
    entersearch {
        bind "Esc" "Ctrl c" { SwitchToMode "scroll"; }
        bind "Enter" { SwitchToMode "search"; }
    }
    renametab {
        bind "Enter" { SwitchToMode "locked"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "locked"; }
    }
    renamepane {
        bind "Enter" { SwitchToMode "locked"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "locked"; }
    }
}

plugins {
    compact-bar location="zellij:compact-bar"
    session-manager location="zellij:session-manager"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
    configuration location="zellij:configuration"
    plugin-manager location="zellij:plugin-manager"
    about location="zellij:about"
    // still referenced by zellij's built-in "default" layout
    tab-bar location="zellij:tab-bar"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    filepicker location="zellij:strider" {
        cwd "/"
    }
}

load_plugins {
    "zellij:link"   // click-to-open file paths
}

// ---- behaviour -----------------------------------------------------
default_mode "locked"
default_layout "compact-top"
theme "terafox"
pane_frame_style "titles"      // 0.45 default, stated explicitly
show_startup_tips true
show_release_notes true
scroll_buffer_size 50000
copy_command "pbcopy"
copy_on_select true
scrollback_editor "nvim"
on_force_close "detach"
session_serialization true
serialize_pane_viewport true
mouse_mode true
